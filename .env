THEME=https://raw.githubusercontent.com/birneee/obsidian-adwaita-theme/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=false
dgEnableSearch=false
dgShowToc=true
dgLinkPreview=false
dgShowTags=true
SITE_NAME_HEADER=Datorspēļu dizains un programmēšana
SITE_MAIN_LANGUAGE=lv
SITE_BASE_URL=https://gamedevclublv.netlify.app/
SHOW_CREATED_TIMESTAMP=false
