SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --anp-background-image-dark: url("https://i.redd.it/bif92xjvyxmg1.jpeg"); --frontmatter-background-opacity: 1; --anp-background-image-light: url("https://i.redd.it/bif92xjvyxmg1.jpeg"); --anp-rainbow-folder-bg-opacity: 0.9; --anp-file-label-align: 0; --anp-custom-bg-blur-dark: 5px; --anp-custom-bg-card-fg-opacity-dark: 0.4; --anp-colorful-frame-opacity: 1; --anp-depth-tab-opacity: 0.6; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-linux is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager is-maximized ctp-latte ctp-mocha ctp-accent-red anuppuccin-accent-toggle anp-current-line anp-callout-color-toggle anp-custom-checkboxes anp-speech-bubble anp-codeblock-numbers anp-latex-inline-text anp-latex-block-text anp-list-toggle anp-table-toggle anp-table-width anp-table-auto anp-table-th-highlight anp-td-none anp-toggle-preview anp-color-transition-toggle anp-autohide-titlebar anp-toggle-scrollbars anp-hide-external-link-icon anp-header-color-toggle anp-header-margin-toggle anp-header-divider-color-toggle anp-h1-red anp-h2-peach anp-h3-green anp-h4-teal anp-h5-lavender anp-h6-mauve anp-decoration-toggle anp-bold-red anp-italic-green anp-highlight-yellow anp-canvas-dark-bg anp-colorful-frame anp-custom-vault-toggle anp-floating-header anp-collapse-folders anp-pdf-blend-toggle-dark anp-pdf-blend-toggle-light anp-full-rainbow-color-toggle anp-simple-rainbow-title-toggle anp-simple-rainbow-collapse-icon-toggle anp-simple-rainbow-indentation-toggle anp-simple-rainbow-icon-toggle anp-rainbow-subfolder-color-toggle anp-safari-tab-toggle anp-disable-newtab-align anp-bg-fix anp-card-shadows anp-card-layout-actions anp-card-layout-filebrowser anp-theme-ext-light anp-theme-ext-dark ctp-gruvbox-light ctp-kanagawa-dark
